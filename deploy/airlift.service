# airlift tower — systemd unit (installed to /etc/systemd/system/airlift.service).
# Runs the tower as an unprivileged user on 127.0.0.1:8443; Caddy fronts it with TLS.
[Unit]
Description=airlift tower (optical file transfer)
Documentation=https://github.com/sujaykumarsuman/airlift
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=airlift
Group=airlift
Environment=AIRLIFT_HOME=/var/lib/airlift/.airlift
ExecStart=/usr/local/bin/airlift tower
Restart=on-failure
RestartSec=3

# Hardening: the tower needs only its own state directory and an outbound-free
# localhost listener.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/var/lib/airlift
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
